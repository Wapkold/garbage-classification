# Не версионируем сами данные — только структуру папок.
# Датасет восстанавливается скриптом загрузки / ссылкой в README.

# Всё содержимое data/ по умолчанию игнорируется
*

# ...кроме служебных файлов, задающих структуру
!.gitignore
!raw/
!processed/
!*/.gitkeep

# Типичные тяжёлые форматы (на случай переопределения правил выше)
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.h5
*.parquet
*.lmdb
